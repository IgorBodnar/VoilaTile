<UserControl x:Class="VoilaTile.Settings.Views.EditorFloatingCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="480" Height="320">
    <Border CornerRadius="6"
            Background="{DynamicResource Brush.App.Background}"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border}"
            Opacity="{Binding DialogCardOpacity}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="20"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource Brush.Surface}"
                    CornerRadius="6,6,0,0"
                    BorderBrush="Transparent">
                <Border Width="40" Height="6" Background="{DynamicResource Brush.Border}" CornerRadius="3" BorderThickness="0"/>
            </Border>

            <Grid Grid.Row="1" Margin="20,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" FontSize="14" VerticalAlignment="Center" Text="Split Horizontally:" Foreground="{DynamicResource Brush.App.Foreground}" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" FontSize="14" VerticalAlignment="Center" Text="Left Click on a Tile." Foreground="{DynamicResource Brush.App.Foreground}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="14" VerticalAlignment="Center" Text="Split Veritcally:" Foreground="{DynamicResource Brush.App.Foreground}" FontWeight="Bold"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="14" VerticalAlignment="Center" Text="Left Click on a Tile while holding [Shift]." Foreground="{DynamicResource Brush.App.Foreground}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" FontSize="14" VerticalAlignment="Center" Text="Delete Divider:" Foreground="{DynamicResource Brush.App.Foreground}" FontWeight="Bold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="14" VerticalAlignment="Center" Text="Press [R] while dragging a Divider." Foreground="{DynamicResource Brush.App.Foreground}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" FontSize="14" VerticalAlignment="Center" Text="Adjust Layout:" Foreground="{DynamicResource Brush.App.Foreground}" FontWeight="Bold"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" FontSize="14" VerticalAlignment="Center" Text="Left Click and Drag on a Divider Handle." Foreground="{DynamicResource Brush.App.Foreground}"/>
            </Grid>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource Style.Button}"
                        Width="200" 
                        Margin="0,0,30,0" 
                        Click="Cancel_Click" 
                        Background="{DynamicResource Brush.SurfaceAlt2}" 
                        Content="Cancel"/>

                <Button Style="{StaticResource Style.Button}"
                        Width="200" 
                        Click="Save_Click" 
                        Background="{StaticResource Brush.Accent.600}" 
                        Foreground="{StaticResource Brush.OnAccent}"
                        Content="Save &amp; Quit"/>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>

