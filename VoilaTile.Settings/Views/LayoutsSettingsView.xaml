<UserControl x:Class="VoilaTile.Settings.Views.LayoutsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:vm="clr-namespace:VoilaTile.Settings.ViewModels"
             xmlns:views="clr-namespace:VoilaTile.Settings.Views"
             xmlns:behaviors="clr-namespace:VoilaTile.Settings.Behaviors"
             xmlns:helpers="clr-namespace:VoilaTile.Settings.Helpers"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="{DynamicResource Space.2}">
        <Grid.RowDefinitions>
            <RowDefinition Height="45*"/>
            <RowDefinition Height="55*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <!-- Monitors -->
        <Border Grid.Row="0">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="{Binding TotalCanvasWidth}" Height="{Binding TotalCanvasHeight}">
                    <ItemsControl ItemsSource="{Binding Monitors}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemContainerStyle>
                            <Style>
                                <Setter Property="Canvas.Left" Value="{Binding CanvasX}" />
                                <Setter Property="Canvas.Top" Value="{Binding CanvasY}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:MonitorViewModel}">
                                <views:MonitorView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>
            </Viewbox>
        </Border>

        <!-- Template Library -->
        <Border Grid.Row="1" Padding="0,8" Margin="0,8,0,8" CornerRadius="8" Background="{DynamicResource Brush.SurfaceAlt}">
            <ScrollViewer
                    x:Name="TemplatePreviewsScrollViewer"
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    CanContentScroll="True"
                    FocusVisualStyle="{x:Null}"
                    behaviors:ScrollOnDemand.Trigger="{Binding TemplateScrollVersion}"
                    behaviors:ScrollOnDemand.Direction="Bottom">

                <ItemsControl ItemsSource="{Binding TemplatePreviews}"
                      helpers:WrapPanelAdaptive.IdealItemWidth="260"
                      helpers:WrapPanelAdaptive.MinItemWidth="180"
                      helpers:WrapPanelAdaptive.ItemSpacing="10">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Margin" Value="0,0,8,8"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ZoneTemplatePreviewViewModel}">
                            <views:InteractableZoneTemplatePreviewView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{DynamicResource Style.Button}"
                    Content="Edit Current Monitor Layout"
                    Command="{Binding EditCurrentMonitorLayoutCommand}"
                    Background="{DynamicResource Brush.Accent.600}"
                    Foreground="{DynamicResource Brush.OnAccent}"/>

            <Button Grid.Column="2" Style="{DynamicResource Style.Button}"
                    Content="Edit Selected Layout"
                    Command="{Binding EditLayoutCommand}"
                    Margin="0,0,6,0"
                    Background="{DynamicResource Brush.Accent.600}"
                    Foreground="{DynamicResource Brush.OnAccent}"/>

            <Button Grid.Column="3" Style="{DynamicResource Style.Button}"
                    Content="Add New Layout"
                    Command="{Binding AddNewLayoutCommand}"
                    Background="{DynamicResource Brush.Accent.600}"
                    Foreground="{DynamicResource Brush.OnAccent}"/>

        </Grid>
    </Grid>
</UserControl>

