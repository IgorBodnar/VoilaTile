      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\Dialogs\CreateNewLayoutDialogView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\Dialogs\InformationDialogView.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\Dialogs\RenameDialogView.xaml.cs">
      <SubType>Code</SubType>
