<Application x:Class="VoilaTile.Settings.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:VoilaTile.Settings.ViewModels"
             xmlns:views="clr-namespace:VoilaTile.Settings.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Merge the current theme dictionary; ThemeManager will swap Light/Dark at runtime -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Theming/Themes/Dark.xaml" />
                <ResourceDictionary Source="/Theming/Styles/Inputs.xaml" />
                <ResourceDictionary Source="/Theming/Styles/Navigation.xaml" />
                <ResourceDictionary Source="/Theming/Styles/WindowChrome.xaml" />
                <ResourceDictionary Source="/Theming/Styles/Text.xaml" />
                <ResourceDictionary Source="/Theming/Styles/ScrollBars.xaml" />
                <ResourceDictionary Source="/Theming/Styles/ToolTip.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Accent palette placeholders (updated at runtime by ThemeManager/AccentPaletteGenerator) -->
            <SolidColorBrush x:Key="Brush.Accent.050" Color="#FFEFF6FF"/>
            <SolidColorBrush x:Key="Brush.Accent.100" Color="#FFD6EAFF"/>
            <SolidColorBrush x:Key="Brush.Accent.200" Color="#FFB3D2FF"/>
            <SolidColorBrush x:Key="Brush.Accent.300" Color="#FF8CB8FF"/>
            <SolidColorBrush x:Key="Brush.Accent.400" Color="#FF6AA3FF"/>
            <SolidColorBrush x:Key="Brush.Accent.500" Color="#FF4C8CFF"/>
            <SolidColorBrush x:Key="Brush.Accent.600" Color="#FF3E78E0"/>
            <SolidColorBrush x:Key="Brush.Accent.700" Color="#FF3363BD"/>
            <SolidColorBrush x:Key="Brush.Accent.800" Color="#FF2A519C"/>
            <SolidColorBrush x:Key="Brush.Accent.900" Color="#FF24467F"/>
            <SolidColorBrush x:Key="Brush.OnAccent"   Color="#FFFFFFFF"/>

            <!-- Translucent accents -->
            <SolidColorBrush x:Key="Brush.Accent.600.T04" Color="#0A3E78E0"/> <!-- 4% -->
            <SolidColorBrush x:Key="Brush.Accent.600.T08" Color="#143E78E0"/> <!-- 8% -->
            <SolidColorBrush x:Key="Brush.Accent.600.T12" Color="#1F3E78E0"/> <!-- 12% -->
            <SolidColorBrush x:Key="Brush.Accent.600.T16" Color="#293E78E0"/> <!-- 16% -->
            <SolidColorBrush x:Key="Brush.Accent.600.T24" Color="#3D3E78E0"/> <!-- 24% -->
            <SolidColorBrush x:Key="Brush.Accent.600.T32" Color="#523E78E0"/> <!-- 32% -->
            <SolidColorBrush x:Key="Brush.Accent.600.T48" Color="#7A3E78E0"/> <!-- 48% -->

            <!-- Common utilities -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
            <FontFamily x:Key="Font.MDL2">Segoe MDL2 Assets</FontFamily>

            <!-- Spacing tokens -->
            <Thickness x:Key="Space.1">4</Thickness>
            <Thickness x:Key="Space.2">8</Thickness>
            <Thickness x:Key="Space.3">12</Thickness>
            <Thickness x:Key="Space.4">16</Thickness>
        
             <!-- Map dialog body VMs to Views -->
            <DataTemplate DataType="{x:Type vm:CreateNewLayoutDialogViewModel}">
                <views:CreateNewLayoutDialogView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:RenameDialogViewModel}">
                <views:RenameDialogView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:InformationDialogViewModel}">
                <views:InformationDialogView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ConfirmationDialogViewModel}">
                <views:ConfirmationDialogView />
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>

