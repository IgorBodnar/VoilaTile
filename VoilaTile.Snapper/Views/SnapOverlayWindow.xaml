<Window x:Class="VoilaTile.Snapper.Views.SnapOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VoilaTile.Snapper.ViewModels"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="{StaticResource BackgroundDarkGray}"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Focusable="False">

    <Window.Resources>
        <Style TargetType="Rectangle" x:Key="TileRectangleStyle">
            <Setter Property="Stroke" Value="{StaticResource TextWhite}" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="RenderOptions.EdgeMode" Value="Aliased" />

            <Style.Triggers>
                <!-- Partial match (highlighted) -->
                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AccentRedFaint}" />
                </DataTrigger>

                <!-- Exact match (stronger) -->
                <DataTrigger Binding="{Binding IsMatched}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource AccentRedTranslucent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuickGrabBadgeBorderStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderThickness" Value="1.8"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Background" Value="{StaticResource BackgroundDarkGray}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BackgroundLightestGray}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <!-- Selected: stronger background/border and a tiny scale-up -->
                <DataTrigger Binding="{Binding IsMatched}" Value="True">
                    <Setter Property="Background" Value="{StaticResource BackgroundDarkestGray}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentRed}"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.08" ScaleY="1.08"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid>
        <Canvas>
            <!-- Tiles -->
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TileViewModel}">
                        <Canvas>
                            <Rectangle
                                Style="{StaticResource TileRectangleStyle}"
                                Width="{Binding Width}"
                                Height="{Binding Height}">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="{Binding X}" Y="{Binding Y}" />
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Hints -->
            <ItemsControl ItemsSource="{Binding Tiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TileViewModel}">
                        <Canvas>
                            <Grid
                                Width="66" Height="36"
                                Canvas.Left="{Binding CenterX}"
                                Canvas.Top="{Binding CenterY}"
                                RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="-33" Y="-18"/>
                                </Grid.RenderTransform>

                                <Border Style="{StaticResource QuickGrabBadgeBorderStyle}">
                                    <TextBlock Text="{Binding Hint}"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextWhite}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               TextOptions.TextFormattingMode="Display"
                                               TextOptions.TextRenderingMode="ClearType"
                                               SnapsToDevicePixels="True"/>
                                </Border>
                            </Grid>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>

        <!-- Input bar at bottoms -->
        <TextBlock Text="{Binding CurrentInput}"
                   FontFamily="Consolas"
                   FontSize="18"
                   Foreground="{StaticResource TextWhite}"
                   Background="{StaticResource BackgroundDarkGray}"
                   HorizontalAlignment="Stretch"
                   VerticalAlignment="Bottom"
                   Padding="10" />
    </Grid>
</Window>

