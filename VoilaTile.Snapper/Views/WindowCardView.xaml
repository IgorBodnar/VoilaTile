<UserControl x:Class="VoilaTile.Snapper.Views.WindowCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="180" d:DesignWidth="280">

    <Border CornerRadius="12"
            Padding="6"
            Margin="8"
            Background="{DynamicResource Brush.SurfaceAlt2}"
            BorderThickness="1.6">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent.600}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid Width="{Binding ThumbWidth}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBlock"
                    Grid.Row="0"
                    Background="{DynamicResource Brush.Surface}"
                    CornerRadius="8"
                    Padding="8,6"
                    Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Column="0"
                           Width="18" Height="18"
                           Source="{Binding Icon}"
                           Stretch="UniformToFill"/>

                    <StackPanel Grid.Column="1" Orientation="Vertical" Margin="8,0,8,0">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.App.Foreground}"/>
                        <TextBlock Text="{Binding Subtitle}"
                                   FontSize="12" Opacity="0.7"
                                   TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Brush.App.Foreground}"/>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="#20FFFFFF"
                            CornerRadius="6"
                            Padding="6,4"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Hint}"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   Foreground="{DynamicResource Brush.App.Foreground}"/>
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="ThumbnailSlot"
                    Grid.Row="1"
                    Width="{Binding ThumbWidth}"
                    Height="{Binding ThumbHeight}"
                    CornerRadius="8"
                    Background="{DynamicResource Brush.App.Background}"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Border}"/>
        </Grid>
    </Border>
</UserControl>

