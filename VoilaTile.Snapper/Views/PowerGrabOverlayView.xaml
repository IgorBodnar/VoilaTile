<Window x:Class="VoilaTile.Snapper.Views.PowerGrabOverlayView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VoilaTile.Snapper.ViewModels"
        xmlns:views="clr-namespace:VoilaTile.Snapper.Views"
        Title="VoilaTile — Power Mode"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource BackgroundDarkestGray}">
    <Grid x:Name="Root" Margin="16" Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel x:Name="Header" Grid.Row="0" Margin="0,0,0,12">
            <views:VoilaTileIcon Width="36" Margin="0,0,12,0"/>
            <Border Background="{StaticResource BackgroundLightGray}"
                    CornerRadius="8"
                    Padding="8,4"
                    Margin="0,0,0,0">
                <TextBlock Text="{Binding HintBuffer}"
                           FontFamily="Consolas"
                           FontSize="14"
                           Foreground="{StaticResource TextWhite}"/>
            </Border>
        </DockPanel>

        <!-- Footer -->
        <DockPanel x:Name="Footer" Grid.Row="2" Margin="0,12,0,0" HorizontalAlignment="Center">
            <TextBlock Text="Type hints to select respective windows    |    Press 'Enter' or 'Space' to switch to the selected window    |    Hold 'Tab' to see a preview of the selected window    |    Press '+' key without holding 'Shift' to scroll down    |    Press '-' key without holding 'Shift' to scoll up    |    Press 'Esc' to close the overlay"
                       FontSize="12" FontWeight="SemiBold"
                       Foreground="#44FFFFFF"/>
        </DockPanel>

        <!-- Viewport -->
        <ScrollViewer x:Name="CardsScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Focusable="False">
            <ItemsControl x:Name="CardsItems" ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:WindowCardViewModel}">
                        <views:WindowCardView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Preview overlay -->
        <Grid x:Name="PreviewLayer"
              Grid.RowSpan="3"
              Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="999">
            <Border Background="#DD000000"/>
            <Border HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="24"
                    CornerRadius="12"
                    Padding="16"
                    Background="{StaticResource BackgroundLightGray}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Vertical" Margin="0,0,0,12">
                        <TextBlock Text="{Binding PreviewTarget.Title}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextWhite}"/>
                        <TextBlock Text="{Binding PreviewTarget.TypeLabel}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextWhiteTranslucent}">
                        </TextBlock>
                    </StackPanel>

                    <Border x:Name="PreviewThumbnailSlot"
                            Grid.Row="2"
                            CornerRadius="8"
                            Background="{StaticResource BackgroundDarkGray}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

