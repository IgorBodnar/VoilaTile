<Window x:Class="VoilaTile.Snapper.Views.PowerGrabOverlayView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:VoilaTile.Snapper.ViewModels"
        xmlns:views="clr-namespace:VoilaTile.Snapper.Views"
        Title="VoilaTile — Power Mode"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="{StaticResource BackgroundDarkestGray}">
    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    </Window.Resources>

    <Grid x:Name="Root" Margin="16" Focusable="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel x:Name="Header" Grid.Row="0" Margin="0,0,0,12">
            <views:VoilaTileIcon Width="36" Margin="0,0,12,0"/>
            <Border Background="{StaticResource BackgroundLightGray}"
                    CornerRadius="8"
                    Padding="8,4"
                    Margin="0,0,0,0">
                <TextBlock Text="{Binding HintBuffer}"
                           FontFamily="Consolas"
                           FontSize="14"
                           Foreground="{StaticResource TextWhite}"/>
            </Border>
        </DockPanel>

        <!-- Footer -->
        <DockPanel x:Name="Footer"
           Grid.Row="2"
           Margin="0,12,0,0"
           HorizontalAlignment="Stretch">
            <Viewbox Stretch="Uniform"
             StretchDirection="DownOnly"
             HorizontalAlignment="Stretch">
                <TextBlock Text="Type hints to select respective windows    |    Press 'Enter' or 'Space' to switch to the selected window    |    Hold 'Tab' to see a preview of the selected window    |    Press '+' key without holding 'Shift' to scroll down    |    Press '-' key without holding 'Shift' to scroll up    |    Press 'Esc' to close the overlay"
                   FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="#44FFFFFF"
                   TextWrapping="NoWrap"/>
            </Viewbox>
        </DockPanel>

        <!-- Viewport -->
        <ScrollViewer x:Name="CardsScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      Focusable="False">
            <ItemsControl x:Name="CardsItems" ItemsSource="{Binding Cards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:WindowCardViewModel}">
                        <views:WindowCardView/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Preview overlay -->
        <Grid x:Name="PreviewLayer"
              Grid.RowSpan="3"
              Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Panel.ZIndex="999">
            <Border Background="#DD000000"/>
            <Border HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="24"
                    CornerRadius="12"
                    Padding="16"
                    Background="{StaticResource BackgroundLightGray}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding PreviewTarget.Title}"
                                   Grid.Row="0"
                                   Grid.Column="0"
                                   Margin="0,0,0,8"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextWhite}"/>

                        <TextBlock Text="{Binding PreviewTarget.TypeLabel}"
                                   Grid.Row="1"
                                   Grid.Column="0"
                                   DockPanel.Dock="Left"
                                   FontSize="12"
                                   Foreground="{StaticResource TextWhiteTranslucent}"/>

                        <StackPanel Orientation="Horizontal"
                                    Grid.Row="1"
                                    Grid.Column="1">

                            <TextBlock Text="&#xE950;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="16"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextWhiteTranslucent}"/>
                            <TextBlock Text="{Binding PreviewStats.CpuPercent, StringFormat={}{0:F1}% CPU}"
                                       TextAlignment="Right"
                                       FontSize="12"
                                       MinWidth="60"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextWhiteTranslucent}"/>

                            <TextBlock Text="&#xE964;"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="16"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextWhiteTranslucent}"/>
                            <TextBlock Text="{Binding PreviewStats.RamPercent, StringFormat={}{0:F1}% RAM}"
                                       TextAlignment="Right"
                                       FontSize="12"
                                       MinWidth="60"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextWhiteTranslucent}"/>

                        </StackPanel>

                    </Grid>

                    <Border x:Name="PreviewThumbnailSlot"
                            Grid.Row="2"
                            CornerRadius="8"
                            Background="{StaticResource BackgroundDarkGray}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

